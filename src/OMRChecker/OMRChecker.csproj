<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- OpenCvSharp4 原生库为 x64，必须关闭 Framework exe 默认的 Prefer32Bit -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OMRChecker</RootNamespace>
    <AssemblyName>OMRChecker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenCV 绑定（含 Windows 原生运行时）；Linux 需另行引用对应 runtime 包 -->
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.10.0.20241108" />
    <!-- JSON Schema (draft 2020-12) 校验，对应 Python 的 jsonschema -->
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <!-- PDF 渲染（PDFium），对应 Python 的 PyMuPDF 渲染部分 -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- 读取 PDF 内嵌图片尺寸，用于 pdf_dpi = "auto" 的原生 DPI 推断 -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- 为 net48 补齐 record/init/required/Index/Range 等新语法所需的编译器类型 -->
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 三份 schema 由 Python 源码中的字典原样导出 -->
    <EmbeddedResource Include="Schemas\*.json" LogicalName="Schemas.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OMRChecker.Tests" />
  </ItemGroup>

</Project>
